+/**
+ * Package-owned invariant companion for `@deepseek-ai/dsh-prompt-image-bridge`.
+ * @module @deepseek-ai/dsh-prompt-image-bridge/invariant
+ */
+
+/* jscpd:ignore-start */
+import type { Context } from '@deepseek-ai/cordis'
+import type { InvariantInstaller } from '@deepseek-ai/dsh-invariants'
+
+const PACKAGE_NAME = '@deepseek-ai/dsh-prompt-image-bridge'
+
+/** Cordis companion plugin name. */
+export const name = 'prompt-image-bridge-invariant'
+/** Service required before package ownership can be reserved. */
+export const inject = ['invariants']
+
+/**
+ * No separate runtime invariant: the bridge's owned relationship is exercised
+ * at the pre-step boundary, while the subagent runtime owns child lifecycle.
+ */
+const install: InvariantInstaller = () => {
+  // No runtime invariant: the bridge owns no durable relation outside the Agent pre-step rewrite.
+}
+
+/**
+ * Register the package invariant companion.
+ * @param ctx - Cordis context carrying the invariant service.
+ * @returns the registration disposer.
+ */
+export const apply = (ctx: Context): Promise<() => void> =>
+  Promise.resolve(ctx.invariants.register(PACKAGE_NAME, install))
+/* jscpd:ignore-end */

diff --git a/packages/attachment/prompt-image-bridge/tests/bridge.spec.ts b/packages/attachment/prompt-image-bridge/tests/bridge.spec.ts
