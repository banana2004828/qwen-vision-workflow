@@ -0,0 +1,160 @@
+import { describe, expect, it, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { agentEvents } from '@deepseek-ai/dsh-agent'
+import type { Agent, PreStepDecision } from '@deepseek-ai/dsh-agent'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import type { SubagentResult, SubagentRun, SubagentStartRequest } from '@deepseek-ai/dsh-subagent'
+import PromptImageBridge from '../src/index.ts'
+
+function fakeAgent(
+  ctx: Context,
+  header: { agentPreset?: string; origin?: 'subagent' } = {},
+  events: unknown[] = [],
+): Agent {
+  return {
+    id: 'parent' as never,
+    ctx,
+    session: { header: { agentPreset: 'ptc-qwen-vision', ...header }, events },
+    status: 'running',
+    inbox: { nextTurn: [], nextStep: [] },
+  } as unknown as Agent
+}
+
+async function harness(result: SubagentResult = {
+  stopReason: 'completed',
+  output: [{ type: 'text', text: 'Visible logo: DeepSeek Harness.' }],
+}) {
+  const ctx = new Context()
+  const dispose = vi.fn(() => Promise.resolve())
+  const start = vi.fn((_provider: string, _request: SubagentStartRequest): Promise<SubagentRun> => Promise.resolve<SubagentRun>({
+    id: 'vision-child' as never,
+    localAgent: undefined,
+    result: Promise.resolve(result),
+    dispose,
+  }))
+  ctx.provide('subagents', { start } as never)
+  await ctx.plugin(PromptImageBridge, {
+    eligiblePresets: ['ptc-qwen-vision'],
+    modelProvider: 'aliyun-qwen',
+    model: 'qwen3.7-plus',
+  })
+  return { ctx, start, dispose, agent: fakeAgent(ctx) }
+}
+
+describe('PromptImageBridge', () => {
+  it('requires an eligible root-session preset', async () => {
+    const { ctx } = await harness()
+    const ordinary = fakeAgent(ctx, { agentPreset: 'ordinary' })
+    expect(ctx.promptImageBridge.canHandle(ordinary)).toBe(false)
+    const message = createUserMessage({
+      content: [{ type: 'text', text: 'hello' }],
+      source: { kind: 'user' },
+    })
+    expect(() => ctx.promptImageBridge.mark(ordinary, message)).toThrow(/not enabled/)
+    const switched = fakeAgent(ctx, { agentPreset: 'ordinary' }, [{
+      type: 'agent-preset/selected',
+      seq: 1,
+      time: 1,
+      data: { agentPreset: 'ptc-qwen-vision' },
+    }])
+    expect(ctx.promptImageBridge.canHandle(switched)).toBe(true)
+    const switchedAway = fakeAgent(ctx, { agentPreset: 'ptc-qwen-vision' }, [{
+      type: 'agent-preset/selected',
+      seq: 1,
+      time: 1,
+      data: { agentPreset: 'ordinary' },
+    }])
+    expect(ctx.promptImageBridge.canHandle(switchedAway)).toBe(false)
+    expect(ctx.promptImageBridge.canHandle(fakeAgent(ctx, { origin: 'subagent' }))).toBe(false)
+    await ctx.fiber.dispose()
+  })
+
+  it('does not spend the vision route for an ordinary text prompt', async () => {
+    const { ctx, start, agent } = await harness()
+    const message = createUserMessage({
+      content: [{ type: 'text', text: 'hello' }],
+      source: { kind: 'user' },
+    })
+    const decision = await agentEvents(ctx, agent).waterfall(
+      'agent/pre-step',
+      { messages: [message], turn: 1, step: 1, signal: new AbortController().signal },
+      (): Promise<PreStepDecision> => Promise.resolve({ kind: 'enter', messages: [message] }),
+    )
+    expect(decision).toEqual({ kind: 'enter', messages: [message] })
+    expect(start).not.toHaveBeenCalled()
+    await ctx.fiber.dispose()
+  })
+
+  it('routes one marked durable image to Qwen and removes it from the parent prompt', async () => {
+    const { ctx, start, dispose, agent } = await harness()
+    const message = createUserMessage({
+      content: [
+        { type: 'text', text: 'What is visible?' },
+        {
+          type: 'image',
+          attachment: {
+            attachmentId: 'att-image' as never,
+            mediaType: 'image/png',
+            bytes: 10,
+            width: 100,
+            height: 80,
+            name: 'clipboard.png',
+          },
+        },
+      ],
+      source: { kind: 'user' },
+    })
+    ctx.promptImageBridge.mark(agent, message)
+    const decision = await agentEvents(ctx, agent).waterfall(
+      'agent/pre-step',
+      { messages: [message], turn: 1, step: 1, signal: new AbortController().signal },
+      (): Promise<PreStepDecision> => Promise.resolve({ kind: 'enter', messages: [message] }),
+    )
+    expect(start).toHaveBeenCalledOnce()
+    const call = start.mock.calls[0]
+    expect(call).toBeDefined()
+    if (call === undefined) throw new Error('expected one subagent call')
+    const request = call[1]
+    expect(request.agentOptions).toEqual({ provider: 'aliyun-qwen', model: 'qwen3.7-plus', maxTokens: 4096 })
+    expect(request.prompt.some(block => block.type === 'image')).toBe(true)
+    expect(JSON.stringify(request.prompt)).toContain('Describe evidence only')
+    expect(JSON.stringify(request.prompt)).not.toContain('Recommended next actions')
+    expect(request.toolFilter).toEqual({ allow: [] })
+    expect(dispose).toHaveBeenCalledOnce()
+    expect(decision.kind).toBe('enter')
+    if (decision.kind !== 'enter') throw new Error('expected enter decision')
+    expect(decision.messages[0]?.content.some(block => block.type === 'image')).toBe(false)
+    expect(JSON.stringify(decision.messages[0]?.content)).toContain('Visible logo: DeepSeek Harness.')
+    expect(JSON.stringify(decision.messages[0]?.content)).toContain('trust=\\"untrusted-observation\\"')
+    expect(JSON.stringify(decision.messages[0]?.content)).toContain('Do not search for, reopen, or route those images again')
+    await ctx.fiber.dispose()
+  })
+
+  it('disposes the child and rejects a non-completed vision result', async () => {
+    const { ctx, dispose, agent } = await harness({
+      stopReason: 'error',
+      output: [{ type: 'text', text: 'provider failed' }],
+    })
+    const message = createUserMessage({
+      content: [{
+        type: 'image',
+        attachment: {
+          attachmentId: 'att-failed' as never,
+          mediaType: 'image/png',
+          bytes: 10,
+          width: 100,
+          height: 80,
+        },
+      }],
+      source: { kind: 'user' },
+    })
+    ctx.promptImageBridge.mark(agent, message)
+    await expect(agentEvents(ctx, agent).waterfall(
+      'agent/pre-step',
+      { messages: [message], turn: 1, step: 1, signal: new AbortController().signal },
+      (): Promise<PreStepDecision> => Promise.resolve({ kind: 'enter', messages: [message] }),
+    )).rejects.toThrow(/did not complete \(error\): provider failed/)
+    expect(dispose).toHaveBeenCalledOnce()
+    await ctx.fiber.dispose()
+  })
+})

